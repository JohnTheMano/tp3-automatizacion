#!/usr/bin/env sh

echo "======================================"
echo " INICIANDO PRE-COMMIT"
echo "======================================"

echo ""
echo "[1/3] Ejecutando Formatter..."
npx prettier --write src tests

if [ $? -ne 0 ]; then
    echo "ERROR: Falló el Formatter."
    echo "Commit abortado."
    exit 1
fi

echo ""
echo "[2/3] Ejecutando Linter..."
npx eslint src tests

if [ $? -ne 0 ]; then
    echo "ERROR: Falló el Linter."
    echo "Commit abortado."
    exit 1
fi

echo ""
echo "[3/3] Ejecutando pruebas unitarias..."
npm test

if [ $? -ne 0 ]; then
    echo "ERROR: Fallaron las pruebas unitarias."
    echo "Commit abortado."
    exit 1
fi

echo ""
echo "======================================"
echo " PRE-COMMIT OK - CALIDAD EN VERDE"
echo "======================================"

exit 0
